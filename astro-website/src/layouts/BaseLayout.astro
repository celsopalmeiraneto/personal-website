---
import "highlight.js/styles/github-dark-dimmed.css";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  feedLinks?: boolean;
  mermaidScripts?: boolean;
}

const {
  title,
  description = "Father, Husband, Friend, Software Engineer.",
  feedLinks = true,
  mermaidScripts = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@200;400&display=swap"
      rel="stylesheet"
    />
    {
      feedLinks && (
        <>
          <link rel="alternate" type="application/rss+xml" title="Main RSS Feed" href="/rss/main.rss" />
          <link rel="alternate" type="application/atom+xml" title="Main Atom Feed" href="/atom/main.atom" />
        </>
      )
    }
    <title>{title}</title>
    <slot name="head" />
    {
      mermaidScripts && (
        <>
          <script is:inline src="/scripts/mermaid.min.js"></script>
          <script is:inline>mermaid.initialize({ startOnLoad: true })</script>
        </>
      )
    }
  </head>
  <body>
    <div class="grid min-h-screen text-black dark:text-white dark:bg-gray-950 bg-white grid-rows-[auto_1fr_auto]">
      <header class="p-2 md:p-3 h-20 md:h-24 text-white bg-pantone-viva-magenta dark:bg-pantone-ultra-violet flex items-center print:hidden">
        <p class="text-xl md:text-2xl m-0">
          <a href="/">
            Hey there! I am <span class="text-4xl md:text-5xl font-thin">Celso Neto</span>
          </a>
        </p>
      </header>
      <div class="p-3 md:p-4 print:p-0">
        <slot />
      </div>
      <footer class="p-2 md:p-3 h-20 text-white bg-pantone-viva-magenta dark:bg-pantone-ultra-violet flex items-center print:hidden">
        With love from Celso
      </footer>
    </div>
  </body>
</html>
